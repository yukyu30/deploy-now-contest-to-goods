# ローカルでは .env に設定。キーに NEXT_PUBLIC_ を付けないでください。
SUZURI_API_KEY=
# デプロイ nowではプロジェクトの環境変数に同じキーを登録します。
# Fetch Metadata非対応クライアント用の公開origin。プロキシ配下では設定します。
# 通常のブラウザーは Sec-Fetch-Site: same-origin で本番・プレビューを判定します。
# APP_ORIGIN=https://your-app.lolipop-now.app
# Lambda向けChromiumを使う場合。AWS_LAMBDA_FUNCTION_NAMEがあれば自動検出します。
# CHROMIUM_RUNTIME=lambda
# 手動でインストール済みのChromiumを使う場合のみ指定します。
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/path/to/chromium
